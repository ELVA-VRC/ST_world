      }
    },
    {
      "type": "text",
      "text": {
        "ko": "\uB300\uCDA9 5\uC6D4 10\uC77C\uCBE4\uC5D0 \uBC30\uCE58\uB791 \uAD6C\uC0C1\uB3C4 \uB2E4 \uB05D\uB098\uACE0,\nUV \uC815\uB9AC\uAE4C\uC9C0 \uB2E4 \uB05D\uB0B4\uACE0\n\uD398\uC778\uD305\uC744 \uC2DC\uC791\uD55C \uAC83 \uAC19\uB2E4.\n\n\uC774\uB54C\uAE4C\uC9C0\uB294 \uADF8\uB0E5 \uB098\uB9CC\uC758 \uC791\uC5C5\uC2E4 \uB290\uB08C\uC73C\uB85C\n\uAC04\uB2E8\uD55C \uC6D4\uB4DC\uB97C \uC0DD\uAC01 \uC911\uC774\uC5C8\uB2E4.",
        "ja": "\u3060\u3044\u305F\u30445\u670810\u65E5\u9803\u306B\u306F\u3001\n\u914D\u7F6E\u3068\u69CB\u60F3\u3082\u5168\u90E8\u7D42\u308F\u3063\u3066\u3001\n\nUV\u306E\u6574\u7406\u307E\u3067\u5168\u90E8\u6E08\u307E\u305B\u3066\n\u30DA\u30A4\u30F3\u30C8\u3092\u59CB\u3081\u305F\u6C17\u304C\u3059\u308B\u3002\n\n\u3053\u306E\u9803\u307E\u3067\u306F\u3001\n\u305F\u3060\u81EA\u5206\u3060\u3051\u306E\u4F5C\u696D\u90E8\u5C4B\u307F\u305F\u3044\u306A\u611F\u3058\u3067\u3001\n\n\u7C21\u5358\u306A\u30EF\u30FC\u30EB\u30C9\u3092\u4F5C\u308D\u3046\u3068\u601D\u3063\u3066\u3044\u305F\u3002"
      }
    },
    {
      "type": "image",
      "imageSlot": 22,
      "aspect": 1.9104477611940298,
      "width": 512,
      "height": 268,
