  "title": {
    "ko": "26/07/19 - \uAC04\uC811\uC801 \uC218\uD608",
    "ja": "26/07/19 - \u9593\u63A5\u7684\u306A\u8F38\u8840"
  },
  "blocks": [
    {
      "type": "text",
      "text": {
        "ko": "\uAC70\uC758 \uB05D\uC774 \uBCF4\uC774\uB294\uB370 \uC65C \uC791\uC5C5\uC740 \uB05D\uB098\uC9C0 \uC54A\uB294 \uAC78\uAE4C...\n\uACC4\uC18D \uD574\uC57C \uD560 \uAC83\uB4E4\uB9CC \uB298\uC5B4 \uAC04\uB2E4.\n\uB05D\uC774 \uBCF4\uC774\uAE30 \uC2DC\uC791\uD560 \uC988\uC74C\uBD80\uD130 \uD56D\uC0C1 \uCD1D\uB825\uC804 \uC0C1\uD0DC\uAC00 \uB418\uB294\uB370,\n\uC774\uB54C\uAC00 \uAC00\uC7A5 \uD798\uB4E4\uB2E4.\n\uBC25\uB3C4 \uC81C\uB300\uB85C \uBABB \uBA39\uACE0 \uC7A0\uB3C4 \uBABB \uC790\uBA70 \uC791\uC5C5\uD558\uAE30 \uB54C\uBB38\uC5D0 \uC0B6\uC774 \uBB34\uB108\uC9C4\uB2E4.\n\n\uC544\uBB34\uB3C4 \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uB294\uB370 \uD63C\uC790 \uC774\uB798\uC11C \uBB50 \uD558\uB9AC...\n\uC624\uB298\uC740 \uC7A0\uC2DC \uB0B4\uB824\uB193\uC744\uAE4C \uC2F6\uC5C8\uB2E4.\n\uC5B4\uC81C\uBD80\uD130 \u201C\uC5D8\uBC14\uB294 \uC644\uC804\uD788 \uBA58\uD0C8\uC774 \uB098\uAC00 \uBC84\uB838\uC2B5\uB2C8\uB2E4\u201D \uC0C1\uD0DC\uC774\uAE30 \uB54C\uBB38\uC5D0\n\uBC18\uCBE4 \uB204\uC6CC\uC11C \uBB34\uC758\uC2DD\uC801\uC73C\uB85C \uC791\uC5C5\uC744 \uD588\uB2E4.\n\uAE30\uB825\uC774 \uC5C6\uC5B4\uC11C \uAC04\uB2E8\uD558\uC9C0\uB9CC \uADC0\uCC2E\uC740 \uD560 \uC77C\uB4E4\uC744\n\uC870\uAE08\uC529 \uC190\uBCF4\uB358 \uC911,\n\u2018\uBE44\uB514\uC624 \uD50C\uB808\uC774\uB9AC\uC2A4\uD2B8\uB098 \uC815\uB9AC\uD558\uC790\u2019 \uD558\uBA70 \uAE68\uC791\uAC70\uB9AC\uB2E4\uAC00\n\uBB38\uB4DD \uADF8 \uC0AC\uB78C\uC774 \uC0DD\uAC01\uB0AC\uB2E4.\n\n\uADF8\uC804\uC5D0 \uB9CC\uB4E0 \uC6D4\uB4DC\uC778 Naked Cell\uC744 \uC88B\uC544\uD558\uACE0\n\uD648\uC6D4\uB4DC\uB85C \uC4F0\uACE0 \uC788\uB2E4\uACE0 \uD588\uB358 \uADF8 \uC0AC\uB78C...\n\uADF8 \uC0AC\uB78C\uC774 \uD50C\uB808\uC774\uB9AC\uC2A4\uD2B8 \uC880 \uC81C\uBC1C \uC5C5\uB370\uC774\uD2B8\uD574 \uB2EC\uB77C\uACE0\n\uBD80\uD0C1\uD558\uB358 \uAE30\uC5B5\uC774 \uC2A4\uCCD0 \uC9C0\uB098\uAC14\uB2E4.\n\r\n\uB9CC\uB09C \uC9C0 \uD55C 3~4\uB144 \uB410\uB098?\n\uCCAB \uB9CC\uB0A8\uBD80\uD130 \uCC38 \uC774\uB798\uC800\uB798 \uC778\uC5F0\uC774 \uAE4A\uC740 \uC0AC\uB78C\uC774\uC5C8\uB294\uB370,\n\uADF8 \uC0AC\uB78C\uC774 \uBD80\uD0C1\uD588\uB358 Naked Cell\uC758 \uD50C\uB808\uC774\uB9AC\uC2A4\uD2B8\uB294\n\uC544\uC9C1\uB3C4 \uC5C5\uB370\uC774\uD2B8\uD558\uC9C0 \uC54A\uC558\uB2E4.\n\uB09C \uB0B4 \uC8FC\uBCC0\uC758 \uC18C\uC911\uD55C \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uC880 \uB354 \uAD00\uC2EC\uC744 \uAE30\uC6B8\uC77C \uD544\uC694\uAC00 \uC788\uB2E4.\n\r\n\uC9C0\uAE08 \uB2F9\uC7A5 Naked Cell\uC744 \uC5C5\uB370\uC774\uD2B8 \uD560 \uC218 \uC5C6\uAE30\uC5D0\n\uB098\uC911\uC5D0 Naked Cell\uC5D0 \uC5C5\uB370\uC774\uD2B8\uD560 \uD50C\uB808\uC774\uB9AC\uC2A4\uD2B8\uB97C Still Tide\uC5D0\uB3C4 \uCD94\uAC00\uD588\uB2E4.\n\uB2C9\uBCC0\uCE5C\uC0AD\uD588\uB358\uB370, \uD658\uC0DD\uD588\uB294\uC9C0 \uC811\uC5C8\uB294\uC9C0 \uBAA8\uB974\uACA0\uC9C0\uB9CC\n\uADF8 \uC0AC\uB78C\uC774 \uC0C8 \uD50C\uB9AC\uB97C \uBCF8\uB2E4\uBA74 \uC88B\uC744 \uD150\uB370...\n\uBB50, \uC544\uC27D\uC9C0\uB9CC. \uB108\uBB34 \uB2A6\uC5C8\uC9C0\uB9CC. \uADF8 \uC0AC\uB78C\uC744 \uAE30\uB9AC\uBA70 \uD50C\uB808\uC774\uB9AC\uC2A4\uD2B8\uB97C \uB0A8\uAE34\uB2E4.\n\uC2DC\uBC1C \uC0AC\uB791\uD588\uB2E4 \uC798 \uC9C0\uB0B4\uB77C\n\n\uBB50 \uC544\uBB34\uD2BC!!\r\n\n\uC5B4\uCA4C\uBA74 \uB0B4 \uC791\uC5C5\uC740 \uC544\uBB34\uB3C4 \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uB294 \uC791\uC5C5\uC774 \uC544\uB2D0\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uB2E4!!\n\uBC25 \uC880 \uBA39\uACE0 \uC790\uACE0 \uC77C\uC5B4\uB098\uC11C \uB2E4\uC2DC \uD798\uC744 \uB0B4\uC57C\uACA0\uB2E4!!",
        "ja": "\u3082\u3046\u7D42\u308F\u308A\u304C\u898B\u3048\u3066\u3044\u308B\u306E\u306B\u3001\n\u3069\u3046\u3057\u3066\u4F5C\u696D\u306F\u7D42\u308F\u3089\u306A\u3044\u3093\u3060\u308D\u3046\u2026\u2026\n\n\u3084\u308B\u3053\u3068\u3070\u304B\u308A\u304C\u5897\u3048\u3066\u3044\u304F\u3002\n\n\u7D42\u308F\u308A\u304C\u898B\u3048\u59CB\u3081\u308B\u9803\u304B\u3089\u3001\n\u3044\u3064\u3082\u7DCF\u529B\u6226\u72B6\u614B\u306B\u306A\u308B\u306E\u3060\u3051\u3069\u3001\n\u3053\u306E\u6642\u671F\u304C\u4E00\u756A\u3064\u3089\u3044\u3002\n\n\u307E\u3068\u3082\u306B\u3054\u98EF\u3082\u98DF\u3079\u3089\u308C\u305A\u3001\n\u7720\u308B\u3053\u3068\u3082\u3067\u304D\u306A\u3044\u307E\u307E\u4F5C\u696D\u3059\u308B\u304B\u3089\u3001\n\u751F\u6D3B\u304C\u5D29\u58CA\u3059\u308B\u3002\n\n\u8AB0\u3082\u5F85\u3063\u3066\u3044\u306A\u3044\u306E\u306B\u3001\n\u4E00\u4EBA\u3067\u3053\u3093\u306A\u3053\u3068\u3092\u3057\u3066\u4F55\u306B\u306A\u308B\u3093\u3060\u308D\u3046\u2026\u2026\n\n\u4ECA\u65E5\u306F\u5C11\u3057\u3001\n\u3044\u3063\u305F\u3093\u624B\u3092\u6B62\u3081\u3088\u3046\u304B\u3068\u601D\u3063\u305F\u3002\n\n\u6628\u65E5\u304B\u3089\u305A\u3063\u3068\u3001\n\u300CELVA\u306F\u5B8C\u5168\u306B\u30E1\u30F3\u30BF\u30EB\u304C\u3084\u3089\u308C\u307E\u3057\u305F\u300D\n\u72B6\u614B\u306A\u306E\u3067\u3001\n\n\u534A\u5206\u5BDD\u8EE2\u304C\u3063\u305F\u307E\u307E\u3001\n\u307B\u3068\u3093\u3069\u7121\u610F\u8B58\u306B\u4F5C\u696D\u3092\u3057\u3066\u3044\u305F\u3002\n\n\u6C17\u529B\u304C\u306A\u304F\u3066\u3001\n\u7C21\u5358\u3060\u3051\u3069\u9762\u5012\u306A\u4F5C\u696D\u3092\n\u5C11\u3057\u305A\u3064\u7247\u3065\u3051\u3066\u3044\u305F\u3068\u3053\u308D\u3001\n\n\u300C\u52D5\u753B\u306E\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u3067\u3082\u6574\u7406\u3057\u3088\u3046\u300D\u3068\n\u3061\u307E\u3061\u307E\u3044\u3058\u3063\u3066\u3044\u305F\u3089\u3001\n\u3075\u3068\u3001\u3042\u306E\u4EBA\u306E\u3053\u3068\u3092\u601D\u3044\u51FA\u3057\u305F\u3002\n\n\u4EE5\u524D\u4F5C\u3063\u305F\u30EF\u30FC\u30EB\u30C9\u3001Naked Cell\u3092\u6C17\u306B\u5165\u3063\u3066\u3001\n\u30DB\u30FC\u30E0\u30EF\u30FC\u30EB\u30C9\u306B\u3057\u3066\u3044\u308B\u3068\u8A00\u3063\u3066\u3044\u305F\u3001\n\u3042\u306E\u4EBA\u2026\u2026\n\n\u3042\u306E\u4EBA\u304C\n\u300C\u304A\u9858\u3044\u3060\u304B\u3089\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u3092\u66F4\u65B0\u3057\u3066\u300D\u3068\n\u983C\u3093\u3067\u3044\u305F\u3053\u3068\u304C\u3001\u3075\u3068\u982D\u3092\u3088\u304E\u3063\u305F\u3002\n\n\u51FA\u4F1A\u3063\u3066\u304B\u3089\u3001\n\u3082\u30463\uFF5E4\u5E74\u306B\u306A\u308B\u306E\u304B\u306A\uFF1F\n\n\u6700\u521D\u306B\u4F1A\u3063\u305F\u3068\u304D\u304B\u3089\u3001\n\u4F55\u304B\u3068\u7E01\u306E\u6DF1\u3044\u4EBA\u3060\u3063\u305F\u306E\u306B\u3001\n\n\u3042\u306E\u4EBA\u306B\u983C\u307E\u308C\u3066\u3044\u305F\nNaked Cell\u306E\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u306F\u3001\n\u3044\u307E\u3060\u306B\u66F4\u65B0\u3057\u3066\u3044\u306A\u3044\u3002\n\n\u79C1\u306F\u3001\u8EAB\u8FD1\u306B\u3044\u308B\u5927\u5207\u306A\u4EBA\u305F\u3061\u3092\n\u3082\u3046\u5C11\u3057\u6C17\u306B\u304B\u3051\u308B\u5FC5\u8981\u304C\u3042\u308B\u3002\n\n\u4ECA\u3059\u3050Naked Cell\u3092\n\u66F4\u65B0\u3059\u308B\u3053\u3068\u306F\u3067\u304D\u306A\u3044\u306E\u3067\u3001\n\n\u3044\u305A\u308CNaked Cell\u306B\u8FFD\u52A0\u3059\u308B\u4E88\u5B9A\u306E\n\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u3092\u3001\nStill Tide\u306E\u307B\u3046\u306B\u3082\u8FFD\u52A0\u3057\u305F\u3002\n\n\u540D\u524D\u3092\u5909\u3048\u3066\u3001\n\u30D5\u30EC\u30F3\u30C9\u3082\u5207\u3063\u3066\u3044\u305F\u307F\u305F\u3044\u3067\u3001\n\n\u8EE2\u751F\u3057\u305F\u306E\u304B\u3001\nVRChat\u3092\u8F9E\u3081\u305F\u306E\u304B\u306F\u5206\u304B\u3089\u306A\u3044\u3051\u3069\u3001\n\n\u3042\u306E\u4EBA\u304C\u65B0\u3057\u3044\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u3092\n\u898B\u3066\u304F\u308C\u305F\u3089\u3044\u3044\u306E\u306B\u2026\u2026\n\n\u307E\u3042\u3001\u6B8B\u5FF5\u3060\u3051\u3069\u3002\n\u9045\u305